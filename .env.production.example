# Production environment for docker-compose.yml
# On the VM: copy to /opt/vyostra/.env and fill in. Never commit the real file.

# --- Hosting ---
# Public hostname Caddy serves (and gets a TLS cert for).
# No domain? Use <vm-ip-with-dashes>.sslip.io, e.g. 140-238-1-2.sslip.io
APP_DOMAIN=
# Image to run. Set by the deploy workflow; leave as-is for a local build.
APP_IMAGE=ghcr.io/akvinayaktiwari/vyostraai-interview:latest

# --- Database (container-internal, never exposed publicly) ---
POSTGRES_USER=vyostra
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=ai_interview_platform

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Must be https://<APP_DOMAIN>
NEXTAUTH_URL=

# --- AI model (any OpenAI-compatible endpoint) ---
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_MODEL=gpt-4o

# --- Speech ---
DEEPGRAM_API_KEY=
TTS_PROVIDER=deepgram
EDGE_TTS_VOICE=en-IN-NeerjaNeural
EDGE_TTS_RATE=+10%

# --- Proctoring ---
MAX_PROCTORING_STRIKES=20

# --- Email (optional; falls back to console logging) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Never true in production
NEXT_PUBLIC_AUTH_DISABLED=false
